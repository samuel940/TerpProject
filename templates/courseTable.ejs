
<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<title><%= name %> - Terp Rating Viewer</title>
	<link rel="stylesheet" href="/webstyle.css">
</head>

<body>
	<header>
		<h1>Terp Rating Viewer</h1>
		<nav>
			<a href="/">
				<button>Home</button>
			</a>
        </nav>
		
	</header>
	<p> How good <%= name %> is at all their courses</p>
	<nav class="sorting">Sort By: <br>
		<button onclick="sortCourseTable('ratings')">
        Ratings
		</button>

		<button onclick="sortCourseTable('reviewTotal')">
			Review Total
		</button>
	
	</nav>
	<div id="tableContainer">
		<%- table -%>
	</div>
	<!-- giving myself credit -->
    <footer>
        <p>This is an unofficial project made by samuel940</p>
    </footer>

	
	
</body>
<script>

	
	async function sortCourseTable(parameter) {
	const professor = "<%= name %>";

	// calling sorted json file
	const response = await fetch(
		`/sort/${parameter}?table=course&name=${professor}`
	);

	// recreating table
	const matches = await response.json();
	let table ='<table><tr><th>Course</th><th>Average Rating</th><th>Total Reviews</th></tr>';

	matches.forEach(course => {
		table += `<tr>
			<td>${course.course}</td>
			<td>${course.average_rating}</td>
			<td>${course.total_reviews}</td>
		</tr>`;
	});

	table += `</table>`;

	document.getElementById("tableContainer").innerHTML = table;
	
	
	}
</script>


</html>

