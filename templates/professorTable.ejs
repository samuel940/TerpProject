<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<title>Terp Rating Viewer - Rating all professors at course</title>
	<link rel="stylesheet" href="/webstyle.css">
</head>

<body>
	<header>
		<h1>Terp Rating Viewer</h1>
		<nav>
			<a href="/">
				<button>Home</button>
			</a>
        </nav>
		
	</header>

	<p> How good all professors are at <%- course -%> based on star ranking</p>

	<nav>
		Sort By: <br>

		<button onclick="sortProfessorTable('ratings')">
			Ratings
		</button>

		<button onclick="sortProfessorTable('reviewTotal')">
			Review Total
		</button>
	</nav>

	<div id="tableContainer">
		<%- professorTable -%>
	</div>

	<!-- giving myself credit -->
    <footer>
        <p>Made by Samuel Rowe</p>
    </footer>

</body>

<script>

	async function sortProfessorTable(parameter) {
		// getting current course
		const params = new URLSearchParams(window.location.search);
		const course = params.get('course');

		// calling sorted json file
		const response = await fetch(
			`/sort/${parameter}?table=professor&name=${course}`
		);

		// recreating table
		const matches = await response.json();
		let table = '<table><tr><th>Professor</th><th>Average Rating</th><th>Total Reviews</th></tr>';

		matches.forEach(professor => {

			table += `<tr>
				<td>${professor.professor}</td>
				<td>${professor.average_rating}</td>
				<td>${professor.total_reviews}</td>
			</tr>`;
		});

		table += `</table>`;

		document.getElementById("tableContainer").innerHTML = table;
	}

</script>

</html>
