
<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<title>Terp Rating Viewer</title>
	<link rel="stylesheet" href="/webstyle.css">
</head>

<body>
	<header class="mainHead">
		<h1>Terp Rating Viewer</h1>
		
	</header>
	<div class="searching">
		<div class="searchDiv">
			<form action="/results" method="get">
				<strong>Search for any Professor our course</strong><br>
				<input type="text" id="textInput" class="searchInput" name="search_query" autocomplete="off" required>

				<div id="searchSuggestions" class="suggestions"></div>
				<button type="submit">Search</button><br>
				<strong>This includes... </strong><br>
				<%= courseTotal %> courses<br>
				<%= profTotal %> Professors
				
			</form>
			<% if (errorSearch) { %>
				<div class="error-message">
					<%- errorSearch -%>
				</div>
			<% } %>
			
		</div>
	</div>
	<!-- giving myself credit -->
    <footer>
        <p>This is an unofficial project made by samuel940</p>
    </footer>

	
	
</body>
<script>
	async function createAutocomplete() {
		const input = document.getElementById("textInput");
		const suggestionsBox = document.getElementById("searchSuggestions");

		// read the input text
		input.addEventListener("input", async () => {

			const query = input.value.trim();

			// do nothing if less then 3 characters
			if (query.length < 3) {
			suggestionsBox.innerHTML = "";
			return;
			}

			const response = await fetch(`/suggestion?q=${query}`);
			const matches = await response.json();

			// adding boxes for suggestion
			suggestionsBox.innerHTML = matches.map(item => `
			<div class="suggestion-item">
				${item}
			</div>
			`).join("");

			// when you click suggestion
			document.querySelectorAll(`#searchSuggestions .suggestion-item`)
			.forEach(div => {
				
				div.addEventListener("click", () => {
				input.value = div.textContent.trim();
				suggestionsBox.innerHTML = "";
				});

			});

		});
		

	}

	createAutocomplete();

	// remove error message
	setTimeout(() => {
		document.querySelectorAll(".error-message").forEach(error => {
			// fade out and then delete
			error.style.transition = "opacity 0.5s";
			error.style.opacity = "0";

			
			setTimeout(() => {
				error.remove();
			}, 500);
		});
	}, 5000);

</script>

</html>
