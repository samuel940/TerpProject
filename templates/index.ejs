
<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<title>Terp Rating Viewer</title>
	<link rel="stylesheet" href="/webstyle.css">
</head>

<body>
	<header class="mainHead">
		<h1>Terp Rating Viewer</h1>
		
	</header>
	<div class="searching">
		<div class="leftSearch">
			<form action="/professor" method="get">
				<strong>Search for a Professor</strong><br>
				<input type="text" id="professorInput" name="professor" autocomplete="off" required>

				<div id="professorSuggestions" class="suggestions"></div>
				
				<input type="submit" value="Search">
			</form>
			<% if (errorProf) { %>
				<div class="error-message">
					<%- errorProf -%>
				</div>
			<% } %>
		</div>

		<div class="rightSearch">
			<form action="/course" method="get">
				<strong>Search for a Course</strong><br>
				<input type="text" id="courseInput" name="course" autocomplete="off" required>

				<div id="courseSuggestions" class="suggestions"></div>


				<input type="submit" value="Search">
				
			</form>
			<% if (errorCourse) { %>
				<div class="error-message">
					<%- errorCourse -%>
				</div>
			<% } %>
		</div>
	</div>
	<!-- giving myself credit -->
    <footer>
        <p>Made by Samuel Rowe</p>
    </footer>

	
	
</body>
<script>

	async function setupAutocomplete(inputId, suggestionId, route) {
		//go to correct input and suggestion div
		const input = document.getElementById(inputId);
		const suggestionsBox = document.getElementById(suggestionId);
		
		// read the input text
		input.addEventListener("input", async () => {

			const query = input.value.trim();

			// do nothing if less then 2 characters
			if (query.length < 2) {
			suggestionsBox.innerHTML = "";
			return;
			}

			const response = await fetch(`${route}?q=${query}`);
			const matches = await response.json();

			// create suggestion-item for each item that starts with query
			suggestionsBox.innerHTML = matches.map(item => `
			<div class="suggestion-item">
				${item}
			</div>
			`).join("");

			// click suggestion
			document.querySelectorAll(`#${suggestionId} .suggestion-item`)
			.forEach(div => {
				// when you click a suggestion, fill the textbox with that text value
				div.addEventListener("click", () => {
				input.value = div.textContent.trim();
				suggestionsBox.innerHTML = "";
				});

			});

		});

	}

	// initialize both autocompletes
	setupAutocomplete(
	"professorInput",
	"professorSuggestions",
	"/suggest/professors"
	);

	setupAutocomplete(
	"courseInput",
	"courseSuggestions",
	"/suggest/courses"
	);

	// remove error messages after 5 seconds
	setTimeout(() => {
		document.querySelectorAll(".error-message").forEach(error => {
			// fade out after 5000 ms (5 seconds)
			error.style.transition = "opacity 0.5s";
			error.style.opacity = "0";

			// remove 500 milliseconds after fade out
			setTimeout(() => {
				error.remove();
			}, 500);
		});
	}, 5000);

</script>

</html>
